# Desarrollo local con Docker: copia este archivo como .env y levanta con
#   docker compose -f docker-compose.dev.yml up --build
# En AWS no se usa: cada instancia arma su .env desde Parameter Store (/akaispace/prod/ o /akaispace/test/).
# Genera SECRET_KEY y las contraseñas con (sin $ # " ' ni espacios, porque rompen el .env de Docker Compose):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: el contenedor db de docker-compose.dev.yml (MySQL 8.4).
# DB_USER no puede ser root: la imagen de MySQL crea root aparte, con DB_ROOT_PASSWORD.
# Sin Docker, con MySQL instalado en el computador: DB_HOST=localhost.
DB_NAME=db_akaispace
DB_USER=akaispace
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_HOST=db
DB_PORT=3306
# Solo producción (TLS hacia RDS): DB_SSL_CA=/app/certs/rds-global-bundle.pem

# Imágenes subidas: en desarrollo, la carpeta media/; en AWS, S3 (USE_S3=True y AWS_STORAGE_BUCKET_NAME)
USE_S3=False

# Webpay Plus (Transbank)
# 'integracion' usa las credenciales públicas de prueba de Transbank (no hace falta configurar nada más).
# Para cobrar de verdad: WEBPAY_AMBIENTE=produccion y el código de comercio y la API key que entrega Transbank.
WEBPAY_AMBIENTE=integracion
WEBPAY_CODIGO_COMERCIO=
WEBPAY_API_KEY=

# Correo (confirmación de compra y recuperación de contraseña)
# Sin EMAIL_BACKEND se usa SES por SMTP (producción). En desarrollo, los correos a la consola de Docker:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para enviarlos de verdad con Gmail: activar la verificación en 2 pasos y crear una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords (la contraseña normal de Gmail no funciona).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=akaispacepruebas13@gmail.com
# EMAIL_HOST_PASSWORD=la-contraseña-de-aplicación-de-16-letras
# Con Gmail el remitente debe ser la misma cuenta de EMAIL_HOST_USER
# DEFAULT_FROM_EMAIL=Akai Space <akaispacepruebas13@gmail.com>
# Dirección a la que llegan las respuestas de los clientes ("responder a" de todos los correos).
# Vacía: los correos no llevan "responder a".
CONTACT_EMAIL=
# Dirección pública del sitio, para los enlaces de los correos
SITIO_URL=http://localhost:8000

# Inicio de sesión con Google (HU-02). Opcional: sin estas líneas el botón de Google no se muestra.
# Se crean en Google Cloud Console > APIs y servicios > Credenciales > ID de cliente de OAuth (aplicación web),
# con la URI de redirección http://localhost:8000/accounts/google/login/callback/
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
