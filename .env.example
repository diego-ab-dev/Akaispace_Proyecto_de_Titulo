# Django
# Genera tu propia clave con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos
DB_NAME=db_akaispace
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Webpay Plus (Transbank)
# 'integracion' usa las credenciales públicas de prueba de Transbank (no hace falta configurar nada más).
# Para cobrar de verdad: WEBPAY_AMBIENTE=produccion y el código de comercio y la API key que entrega Transbank.
WEBPAY_AMBIENTE=integracion
WEBPAY_CODIGO_COMERCIO=
WEBPAY_API_KEY=

# Correo (confirmación de compra y recuperación de contraseña)
# Sin configurar, los correos se muestran en la consola de runserver y no se envían.
# Con Gmail: activar la verificación en 2 pasos y crear una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords (la contraseña normal de Gmail no funciona).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=akaispacevaldivia@gmail.com
# EMAIL_HOST_PASSWORD=la-contraseña-de-aplicación-de-16-letras
# Con Gmail el remitente debe ser la misma cuenta de EMAIL_HOST_USER
# DEFAULT_FROM_EMAIL=Akaispace <akaispacevaldivia@gmail.com>
# Dirección pública del sitio, para los enlaces de los correos
SITIO_URL=http://localhost:8000
